# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Restart `npm run dev`
# after creating/editing .env.local — Next.js only reads it at startup.
#
# The anon key is meant to be public (it's safe to ship in client code —
# Supabase's Row Level Security is what actually protects data), so it's
# fine to paste it here.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
